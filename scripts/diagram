#!/usr/bin/env -S uv run --frozen --quiet python
"""Living architecture diagram, diagrams/AS-BUILT.md (protected gate file; plan §3.1b).

  1. grimp component graph (no LLM)
  2. stamp = hash(component graph) + hash(files under [privacy].paths); fresh -> file untouched
  3. stale -> claude -p (Sonnet, no tools, no session) edits the previous diagram minimally
  4. normalize (sorted lines) so cosmetic reshuffles never diff
  5. edge_diff: component edges exact both ways, data-flow edges plausible, ext_* only via gateway.
     LLM output gets one retry with the mismatch list; a fresh-stamp file that fails was hand-edited
     and is blocked with no retry.
  6. --stage: git add the file into the commit being made

Usage: scripts/diagram [--stage]
"""

from __future__ import annotations

import hashlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import edge_diff
import gate

ROOT = gate.ROOT
TARGET = ROOT / "diagrams" / "AS-BUILT.md"
STAMP_RE = re.compile(r"^<!-- stamp: (.*) -->$", re.M)
MERMAID_RE = re.compile(r"```mermaid\n(.*?)```", re.S)
MAX_DIFF_CHARS = 60_000

LLM_RULES = f"""\
You maintain diagrams/AS-BUILT.md for The Primer, a privacy-first algebra tutor for kids.
Output EXACTLY two fenced ```mermaid blocks and nothing else: first the COMPONENT diagram,
then the DATA-FLOW diagram.

Grammar (anything else is rejected by a script):
  flowchart LR
  id[label]  or  id[(label)]  or  id((label))      node declarations, one per line
  a --> b    or  a -->|label| b                    edges, one per line, ids only
  No subgraphs, no styling, no classDef, no inline node labels on edge lines.

Component diagram: one node per component listed below (id = component name) and exactly the
listed real edges (importer --> imported). No other nodes or edges.

Data-flow diagram: how kid data moves (kid input -> session -> gateway -> LLM/speech provider;
profile/mastery state -> encrypted store; the opt-in anonymized upload path, if the code has one).
Node ids: a component name, or ext_* (third-party service), actor_* (a person), data_* (data at
rest). Every edge touching an ext_* node must have `{edge_diff.GATEWAY}` on its other end. An edge
between two components is allowed only if one imports the other.
Draw ONLY flows the code performs today, visible in the diff or the previous diagram. No planned,
implied or typical flows: a component that doesn't move kid data yet stays out of this diagram.

Edit the previous diagram MINIMALLY: keep existing node ids and labels, do not restyle.
"""


def stamp() -> str:
    comps, real = edge_diff.component_graph()
    graph = hashlib.sha256(repr((sorted(comps), sorted(real))).encode()).hexdigest()[:16]
    privacy = gate.content_hash(gate.matches("privacy", gate.repo_files()))
    return f"graph={graph} privacy={privacy}"


def normalize(mermaid: str) -> str:
    lines = {ln.strip() for ln in mermaid.splitlines()}
    lines -= {""}
    lines = {ln for ln in lines if not edge_diff.HEADER_RE.match(ln)}
    nodes = sorted(ln for ln in lines if not edge_diff.EDGE_RE.match(ln))
    edges = sorted(ln for ln in lines if edge_diff.EDGE_RE.match(ln))
    return "\n".join(["flowchart LR", *nodes, *edges]) + "\n"


def render(stamp_: str, components: str, dataflow: str, real: set[edge_diff.Edge]) -> str:
    edge_list = "\n".join(f"- {a} -> {b}" for a, b in sorted(real)) or "- (none)"
    return f"""<!-- Generated by scripts/diagram. Do not edit (protected gate file). -->
<!-- stamp: {stamp_} -->
# As-built architecture

## Components

```mermaid
{normalize(components)}```

## Data flow

```mermaid
{normalize(dataflow)}```

## Verified component edges

importer -> imported, from the grimp import graph:

{edge_list}
"""


def staged_or_working_diff() -> str:
    """Pre-commit: the staged diff. /ship (nothing staged): working diff plus untracked files."""
    diff = gate.git("diff", "--cached")
    if not diff.strip():
        has_head = subprocess.run(
            ["git", "rev-parse", "--verify", "-q", "HEAD"], capture_output=True
        )
        diff = gate.git("diff", "HEAD") if has_head.returncode == 0 else ""
        # Only code the gate reads (src/tests/evals): a stray local DB, log or export in the
        # checkout must never reach the model (P-13). Non-UTF-8 files are skipped.
        untracked = gate.git("ls-files", "-z", "--others", "--exclude-standard").split("\0")
        for path in gate.matches("gate_inputs", [p for p in untracked if p]):
            try:
                body = (ROOT / path).read_text(encoding="utf-8").splitlines()
            except (OSError, UnicodeDecodeError):
                continue
            diff += f"--- /dev/null\n+++ b/{path}\n" + "".join(f"+{ln}\n" for ln in body)
    if len(diff) > MAX_DIFF_CHARS:
        diff = diff[:MAX_DIFF_CHARS] + "\n[diff truncated]\n"
    return diff


def ask_llm(
    prev: str | None, comps: set[str], real: set[edge_diff.Edge], problems: list[str]
) -> str:
    parts = [
        LLM_RULES,
        "Components: " + (", ".join(sorted(comps)) or "(none)"),
        "Real cross-component edges:\n" + "\n".join(f"{a} --> {b}" for a, b in sorted(real)),
        "Previous AS-BUILT.md:\n" + (prev or "(none yet)"),
        "Diff being committed:\n" + staged_or_working_diff(),
    ]
    if problems:
        parts.append("Your last attempt was REJECTED for:\n" + "\n".join(problems))
    with tempfile.TemporaryDirectory() as tmp:  # outside the repo: no project hooks or CLAUDE.md
        result = subprocess.run(
            ["claude", "-p", "--model", "sonnet", "--tools", "", "--no-session-persistence",
             "--setting-sources", "", "--strict-mcp-config", "--disable-slash-commands"],
            input="\n\n".join(parts), cwd=tmp, capture_output=True, text=True, timeout=300,
        )  # fmt: skip
    if result.returncode != 0:
        raise RuntimeError(f"claude -p failed: {result.stderr.strip()[-500:]}")
    return result.stdout


def main(argv: list[str]) -> int:
    comps, real = edge_diff.component_graph()
    current = stamp()
    prev = TARGET.read_text() if TARGET.exists() else None
    prev_stamp = m[1] if prev and (m := STAMP_RE.search(prev)) else None

    if prev is not None and prev_stamp == current:
        problems = edge_diff.check_document(prev, comps, real)
        if problems:
            print("diagram: BLOCKED, AS-BUILT.md does not match the import graph (hand-edited?):")
            print("\n".join(f"  {p}" for p in problems))
            return 1
        print("diagram: fresh, unchanged")
    elif not comps:
        TARGET.parent.mkdir(exist_ok=True)
        TARGET.write_text(render(current, "", "", real))
        print("diagram: empty component graph, baseline written (no LLM)")
    else:
        problems: list[str] = []
        doc = ""
        for attempt in (1, 2):
            found = MERMAID_RE.findall(ask_llm(prev, comps, real, problems))
            if len(found) == 2:
                doc = render(current, found[0], found[1], real)
                problems = edge_diff.check_document(doc, comps, real)
            else:
                problems = [f"expected 2 mermaid blocks, got {len(found)}"]
            if not problems:
                break
            print(f"diagram: attempt {attempt} rejected: {'; '.join(problems)}")
        if problems:
            print("diagram: BLOCKED after one retry. Mismatched edges:")
            print("\n".join(f"  {p}" for p in problems))
            return 1
        TARGET.write_text(doc)
        print("diagram: updated by LLM, edges verified")

    if "--stage" in argv:
        gate.git("add", str(TARGET.relative_to(ROOT)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
