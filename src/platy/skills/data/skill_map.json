{
  "schema_version": 1,
  "subject": "algebra",
  "unit": "solving linear equations",
  "nodes": [
    {
      "id": "integer_arithmetic",
      "name": "Integer arithmetic",
      "description": "Add, subtract, multiply and divide positive and negative whole numbers.",
      "prerequisites": [],
      "probes": [
        {"id": "integer_arithmetic.1", "prompt": "Work out (-6) × (-4).", "equation": "(-6)*(-4)", "variable": null, "answer": "24"},
        {"id": "integer_arithmetic.2", "prompt": "Work out (-42) ÷ (-6).", "equation": "(-42)/(-6)", "variable": null, "answer": "7"},
        {"id": "integer_arithmetic.3", "prompt": "Work out -9 + 4 - 3.", "equation": "-9 + 4 - 3", "variable": null, "answer": "-8"}
      ]
    },
    {
      "id": "order_of_operations",
      "name": "Order of operations",
      "description": "Work out expressions with brackets and mixed operations in the right order.",
      "prerequisites": ["integer_arithmetic"],
      "probes": [
        {"id": "order_of_operations.1", "prompt": "Work out 20 - 3 × (4 + 2).", "equation": "20 - 3*(4 + 2)", "variable": null, "answer": "2"},
        {"id": "order_of_operations.2", "prompt": "Work out 24 ÷ (2 + 6) + 5.", "equation": "24/(2 + 6) + 5", "variable": null, "answer": "8"},
        {"id": "order_of_operations.3", "prompt": "Work out 6 - 2 × (5 + 4).", "equation": "6 - 2*(5 + 4)", "variable": null, "answer": "-12"}
      ]
    },
    {
      "id": "fraction_operations",
      "name": "Fraction operations",
      "description": "Add, subtract, multiply and divide fractions, including negative ones.",
      "prerequisites": ["integer_arithmetic"],
      "probes": [
        {"id": "fraction_operations.1", "prompt": "Work out -1/2 + 3/4.", "equation": "-1/2 + 3/4", "variable": null, "answer": "1/4"},
        {"id": "fraction_operations.2", "prompt": "Work out 2/3 + 1/4.", "equation": "2/3 + 1/4", "variable": null, "answer": "11/12"},
        {"id": "fraction_operations.3", "prompt": "Work out (3/4) ÷ (-9/8).", "equation": "(3/4)/(-9/8)", "variable": null, "answer": "-2/3"}
      ]
    },
    {
      "id": "reciprocals",
      "name": "Reciprocals",
      "description": "Find the number that multiplies a fraction or whole number to give 1.",
      "prerequisites": ["fraction_operations"],
      "probes": [
        {"id": "reciprocals.1", "prompt": "What number times 5 gives 1?", "equation": "5*b = 1", "variable": "b", "answer": "1/5"},
        {"id": "reciprocals.2", "prompt": "What number times 2/3 gives 1?", "equation": "(2/3)*b = 1", "variable": "b", "answer": "3/2"},
        {"id": "reciprocals.3", "prompt": "What number times -3/7 gives 1?", "equation": "(-3/7)*b = 1", "variable": "b", "answer": "-7/3"}
      ]
    },
    {
      "id": "inverse_operations",
      "name": "Inverse operations",
      "description": "Undo an operation with its opposite: adding with subtracting, multiplying with dividing.",
      "prerequisites": ["integer_arithmetic"],
      "probes": [
        {"id": "inverse_operations.1", "prompt": "What do you add to x - 4 to get back to x?", "equation": "x - 4 + b = x", "variable": "b", "answer": "4"},
        {"id": "inverse_operations.2", "prompt": "What do you multiply x/5 by to get back to x?", "equation": "(x/5)*b = x", "variable": "b", "answer": "5"},
        {"id": "inverse_operations.3", "prompt": "What do you add to x + 9 to get back to x?", "equation": "x + 9 + b = x", "variable": "b", "answer": "-9"}
      ]
    },
    {
      "id": "combining_like_terms",
      "name": "Combining like terms",
      "description": "Add and subtract terms that have the same variable part.",
      "prerequisites": ["integer_arithmetic"],
      "probes": [
        {"id": "combining_like_terms.1", "prompt": "Simplify 3x + 5 - x + 2.", "equation": "3*x + 5 - x + 2", "variable": null, "answer": "2*x + 7"},
        {"id": "combining_like_terms.2", "prompt": "Simplify -4y + 6 + 9y - 10.", "equation": "-4*y + 6 + 9*y - 10", "variable": null, "answer": "5*y - 4"},
        {"id": "combining_like_terms.3", "prompt": "Simplify 2n - 8 - 5n + 3.", "equation": "2*n - 8 - 5*n + 3", "variable": null, "answer": "-3*n - 5"}
      ]
    },
    {
      "id": "distributive_property",
      "name": "Distributive property",
      "description": "Multiply a number across a sum or difference in brackets.",
      "prerequisites": ["integer_arithmetic"],
      "probes": [
        {"id": "distributive_property.1", "prompt": "Expand 3(x - 4).", "equation": "3*(x - 4)", "variable": null, "answer": "3*x - 12"},
        {"id": "distributive_property.2", "prompt": "Expand -2(y + 5).", "equation": "-2*(y + 5)", "variable": null, "answer": "-2*y - 10"},
        {"id": "distributive_property.3", "prompt": "Expand -5(2 - 3k).", "equation": "-5*(2 - 3*k)", "variable": null, "answer": "15*k - 10"}
      ]
    },
    {
      "id": "simplifying_expressions",
      "name": "Simplifying expressions",
      "description": "Expand brackets and combine like terms to write an expression in its simplest form.",
      "prerequisites": ["combining_like_terms", "distributive_property"],
      "probes": [
        {"id": "simplifying_expressions.1", "prompt": "Simplify 4(y - 2) + 3y.", "equation": "4*(y - 2) + 3*y", "variable": null, "answer": "7*y - 8"},
        {"id": "simplifying_expressions.2", "prompt": "Simplify 2(x + 3) - 5x.", "equation": "2*(x + 3) - 5*x", "variable": null, "answer": "6 - 3*x"},
        {"id": "simplifying_expressions.3", "prompt": "Simplify -2(n - 1) - 3(n + 4).", "equation": "-2*(n - 1) - 3*(n + 4)", "variable": null, "answer": "-5*n - 10"}
      ]
    },
    {
      "id": "writing_expressions",
      "name": "Writing expressions",
      "description": "Turn a phrase in words into an algebraic expression.",
      "prerequisites": ["order_of_operations"],
      "probes": [
        {"id": "writing_expressions.1", "prompt": "Write an expression for 5 less than 4 times a number k.", "equation": "4*k - 5", "variable": null, "answer": "4*k - 5"},
        {"id": "writing_expressions.2", "prompt": "Write an expression for twice the sum of n and 3.", "equation": "2*(n + 3)", "variable": null, "answer": "2*(n + 3)"},
        {"id": "writing_expressions.3", "prompt": "Write an expression for the difference of p and 7, divided by 3.", "equation": "(p - 7)/3", "variable": null, "answer": "(p - 7)/3"}
      ]
    },
    {
      "id": "one_step_equations",
      "name": "One-step equations",
      "description": "Solve an equation that takes one inverse operation to get the variable on its own.",
      "prerequisites": ["inverse_operations"],
      "probes": [
        {"id": "one_step_equations.1", "prompt": "Solve x - 8 = -3.", "equation": "x - 8 = -3", "variable": "x", "answer": "5"},
        {"id": "one_step_equations.2", "prompt": "Solve x/4 = 6.", "equation": "x/4 = 6", "variable": "x", "answer": "24"},
        {"id": "one_step_equations.3", "prompt": "Solve -5x = 35.", "equation": "-5*x = 35", "variable": "x", "answer": "-7"}
      ]
    },
    {
      "id": "fraction_coefficient_equations",
      "name": "Equations with a fraction coefficient",
      "description": "Solve equations with a fraction coefficient by multiplying both sides by its reciprocal.",
      "prerequisites": ["one_step_equations", "reciprocals"],
      "probes": [
        {"id": "fraction_coefficient_equations.1", "prompt": "Solve (3/4)x = 12.", "equation": "(3/4)*x = 12", "variable": "x", "answer": "16"},
        {"id": "fraction_coefficient_equations.2", "prompt": "Solve (2/5)x = 3/10.", "equation": "(2/5)*x = 3/10", "variable": "x", "answer": "3/4"},
        {"id": "fraction_coefficient_equations.3", "prompt": "Solve (-2/3)x = 8.", "equation": "(-2/3)*x = 8", "variable": "x", "answer": "-12"}
      ]
    },
    {
      "id": "two_step_equations",
      "name": "Two-step equations",
      "description": "Solve equations that take two inverse operations, undoing addition or subtraction first.",
      "prerequisites": ["one_step_equations", "order_of_operations"],
      "probes": [
        {"id": "two_step_equations.1", "prompt": "Solve 3x + 4 = 19.", "equation": "3*x + 4 = 19", "variable": "x", "answer": "5"},
        {"id": "two_step_equations.2", "prompt": "Solve x/3 - 2 = 4.", "equation": "x/3 - 2 = 4", "variable": "x", "answer": "18"},
        {"id": "two_step_equations.3", "prompt": "Solve -2x + 7 = 15.", "equation": "-2*x + 7 = 15", "variable": "x", "answer": "-4"}
      ]
    },
    {
      "id": "multi_step_equations",
      "name": "Multi-step equations",
      "description": "Solve equations that need expanding or combining like terms before the inverse operations.",
      "prerequisites": ["two_step_equations", "simplifying_expressions"],
      "probes": [
        {"id": "multi_step_equations.1", "prompt": "Solve 5x - 2x + 6 = 21.", "equation": "5*x - 2*x + 6 = 21", "variable": "x", "answer": "5"},
        {"id": "multi_step_equations.2", "prompt": "Solve 2(x + 3) + 4x = 30.", "equation": "2*(x + 3) + 4*x = 30", "variable": "x", "answer": "4"},
        {"id": "multi_step_equations.3", "prompt": "Solve 3(x - 2) - 5x = 4.", "equation": "3*(x - 2) - 5*x = 4", "variable": "x", "answer": "-5"}
      ]
    },
    {
      "id": "equations_with_fractions",
      "name": "Equations with fractions",
      "description": "Solve equations with fractional terms, for example by clearing the denominators first.",
      "prerequisites": ["two_step_equations", "fraction_coefficient_equations"],
      "probes": [
        {"id": "equations_with_fractions.1", "prompt": "Solve x/3 + x/6 = 5.", "equation": "x/3 + x/6 = 5", "variable": "x", "answer": "10"},
        {"id": "equations_with_fractions.2", "prompt": "Solve (x + 1)/4 = 2/3.", "equation": "(x + 1)/4 = 2/3", "variable": "x", "answer": "5/3"},
        {"id": "equations_with_fractions.3", "prompt": "Solve x/4 - x/2 = 3.", "equation": "x/4 - x/2 = 3", "variable": "x", "answer": "-12"}
      ]
    },
    {
      "id": "variables_both_sides",
      "name": "Variables on both sides",
      "description": "Solve equations with the variable on both sides by gathering its terms on one side first.",
      "prerequisites": ["multi_step_equations"],
      "probes": [
        {"id": "variables_both_sides.1", "prompt": "Solve 5x + 3 = 2x + 18.", "equation": "5*x + 3 = 2*x + 18", "variable": "x", "answer": "5"},
        {"id": "variables_both_sides.2", "prompt": "Solve 4(x - 2) = 2x + 6.", "equation": "4*(x - 2) = 2*x + 6", "variable": "x", "answer": "7"},
        {"id": "variables_both_sides.3", "prompt": "Solve 7 - 3x = x + 15.", "equation": "7 - 3*x = x + 15", "variable": "x", "answer": "-2"}
      ]
    },
    {
      "id": "linear_equation_word_problems",
      "name": "Linear equation word problems",
      "description": "Write a linear equation for a situation in words, solve it, and check the answer makes sense.",
      "prerequisites": ["variables_both_sides", "equations_with_fractions", "writing_expressions"],
      "probes": [
        {"id": "linear_equation_word_problems.1", "prompt": "One phone plan costs $30 to join plus $5 a month. Another costs $8 a month with nothing to join. After how many months m do they cost the same?", "equation": "30 + 5*m = 8*m", "variable": "m", "answer": "10"},
        {"id": "linear_equation_word_problems.2", "prompt": "A water tank is 1/4 full. After 6 more liters go in, it is 1/2 full. How many liters h does the full tank hold?", "equation": "h/4 + 6 = h/2", "variable": "h", "answer": "24"},
        {"id": "linear_equation_word_problems.3", "prompt": "Doubling a number n and adding 9 gives the same result as taking 4 away from n. What is n?", "equation": "2*n + 9 = n - 4", "variable": "n", "answer": "-13"}
      ]
    }
  ]
}
